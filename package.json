{
  "name": "bng-metric-backend",
  "version": "0.0.0",
  "description": "bng-metric-backend",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "data-dictionary": "node scripts/gen-data-dictionary.js && node scripts/gen-warehouse-erd.js && prettier --write --log-level warn data-dictionary/data-dictionary.md data-dictionary/data-dictionary.json docs/warehouse-erd.md",
    "data-dictionary:check": "npm run data-dictionary && git diff --exit-code -- data-dictionary/data-dictionary.md data-dictionary/data-dictionary.json docs/warehouse-erd.md",
    "db:update": "scripts/liquibase.sh update",
    "db:validate": "scripts/liquibase.sh validate",
    "db:clear-checksums": "scripts/liquibase.sh clearChecksums",
    "england-27700": "node scripts/gen-england-27700.mjs",
    "england-27700:check": "node scripts/gen-england-27700.mjs --check",
    "dev": "node scripts/ensure-env.js && cross-env NODE_ENV=development USE_SWAGGER=true npm run server:watch",
    "dev:debug": "cross-env NODE_ENV=development npm run server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "extract:ngd-style": "node tools/extract-ngd-style.js",
    "git:pre-commit-hook": "npm run data-dictionary:check && npm run security-audit && npm run format:check && npm run lint && npm test",
    "git:pre-push-hook": "npm run data-dictionary:check && npm run test:integration:full",
    "install:gitleaks": "node scripts/install-gitleaks.mjs",
    "lib:link": "npm link ../bng-library",
    "lib:status": "node -e \"const fs=require('node:fs');const p='node_modules/bng-library';try{const s=fs.lstatSync(p);console.log('bng-library: '+(s.isSymbolicLink()?('LINKED -> '+fs.realpathSync(p)):'installed from pin (not linked)'))}catch{console.log('bng-library: not installed')}\"",
    "lib:unlink": "npm uninstall --no-save bng-library && node scripts/npm-install.mjs",
    "lint": "eslint --cache --cache-strategy content \"**/*.{cjs,js}\"",
    "lint:fix": "npm run lint -- --fix",
    "postinstall": "node scripts/postinstall.mjs",
    "security-audit": "npm audit --audit-level=high",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --legacy-watch ./src",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json --legacy-watch ./src",
    "server:watch:9230": "nodemon --inspect=0.0.0.0:9230 --ext js,json --legacy-watch ./src",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "cross-env NODE_ENV=production node --use-strict .",
    "test": "cross-env TZ=UTC vitest run --coverage",
    "test:watch": "cross-env TZ=UTC vitest",
    "test:integration": "cross-env TZ=UTC vitest run --config vitest.integration.config.js",
    "test:integration:coverage": "cross-env TZ=UTC vitest run --config vitest.integration.config.js --coverage --coverage.enabled",
    "test:integration:routes": "node scripts/assert-route-coverage.mjs",
    "test:integration:full": "npm run test:integration:coverage && npm run test:integration:routes"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1133.0",
    "@aws-sdk/credential-providers": "3.1132.0",
    "@aws-sdk/rds-signer": "3.1133.0",
    "@defra/cdp-auditing": "0.6.1",
    "@defra/cdp-metrics": "0.6.0",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/hapi": "21.4.10",
    "@hapi/inert": "7.1.2",
    "@hapi/wreck": "18.1.2",
    "@mapbox/vector-tile": "3.0.0",
    "@turf/bbox": "7.4.0",
    "aws-embedded-metrics": "4.2.1",
    "aws4": "1.13.2",
    "better-sqlite3": "13.0.3",
    "bng-library": "github:DEFRA/bng-library#3a0d4cad1a74759ea91fdfca36e4e3be763f5ab3",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "geos-wasm": "3.1.1",
    "global-agent": "4.1.3",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "https-proxy-agent": "9.1.0",
    "joi": "18.2.9",
    "jose": "6.2.12",
    "node-fetch": "3.3.2",
    "pbf": "5.1.2",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "pg-pool": "3.14.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "proj4": "2.22.0",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-dist": "5.33.0",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@maplibre/vt-pbf": "4.3.2",
    "@types/node": "26.6.1",
    "@vitest/coverage-v8": "5.0.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.2",
    "husky": "9.1.7",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.7",
    "vitest": "5.0.0",
    "vitest-fetch-mock": "0.4.5"
  },
  "overrides": {
    "@hapi/wreck": "18.1.2",
    "vitest": "5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "fast-uri": "3.1.6",
    "@humanfs/node": "0.16.8",
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18"
  }
}
